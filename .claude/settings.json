{
  "permissions": {
    "ask": [
      "Bash(uv run python labs/*)",
      "Bash(uv run --locked python labs/*)",
      "Bash(uv run python .claude/skills/*)",
      "Bash(uv run --locked python .claude/skills/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --locked --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_jinja.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --quiet --locked --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_app.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --quiet --locked --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_mcp.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
